# Keep all classes in the app package from obfuscation or stripping by R8
-keep class com.example.gamepadbridge.** { *; }
-keepclassmembers class com.example.gamepadbridge.** { *; }

# Keep custom views instantiated from XML layout
-keep class com.example.gamepadbridge.GamepadView {
    public <init>(android.content.Context, android.util.AttributeSet);
    public <init>(android.content.Context, android.util.AttributeSet, int);
}
